{
  "$schema": "https://json.schemastore.org/template",
  "author": "Nikolai Davydov",
  "name": "Revit add-in with WebView2 (Davydov)",
  "description": "Revit 2025–2027 add-in: Nice3point SDK and Toolkit, an isolated Launcher, a command pipeline and a React UI in WebView2",
  "shortName": "davydov-revit",
  "identity": "Davydov.Revit.AddIn.Solution",
  "defaultName": "RevitAddin",
  "sourceName": "Davydov.Revit.Addin",
  "preferNameDirectory": true,
  "classifications": [
    "Revit",
    "Desktop",
    "AddIn",
    "Solution"
  ],
  "tags": {
    "type": "solution",
    "editorTreatAs": "solution",
    "language": "C#",
    "platform": ".NET"
  },
  "guids": [
    "A2A3303D-540B-4C7D-9969-77C9FF461888",
    "CA1A2580-51FE-4199-A6B5-62760DC2D3CC",
    "BADACEF9-1500-4A6F-9559-F921B1DEBEB5",
    "8D3B6F2A-4C1E-4F7B-9A65-2E0D7C9B1F43"
  ],
  "symbols": {
    "mcpBasePort": {
      "type": "generated",
      "generator": "random",
      "parameters": {
        "low": 41000,
        "high": 48900
      },
      "replaces": "47250",
      "description": "The MCP base port in Host.cs: its own for every add-in, so two add-ins listen side by side"
    },
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    },
    "SolutionFormat": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Solution format",
      "description": "auto: a classic .sln in Visual Studio, whose «New project» dialog replaces a .slnx; a .slnx everywhere else",
      "choices": [
        {
          "choice": "auto",
          "description": ".sln in Visual Studio, .slnx everywhere else"
        },
        {
          "choice": "slnx",
          "description": "The XML solution format"
        },
        {
          "choice": "sln",
          "description": "The classic solution format"
        }
      ],
      "defaultValue": "auto"
    },
    "useSln": {
      "type": "computed",
      "value": "(SolutionFormat == \"sln\" || (SolutionFormat == \"auto\" && HostIdentifier == \"vs\"))"
    },
    "vendor": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Vendor",
      "description": "The vendor: VendorId of the .addin, the manufacturer of the installer and of the Autodesk bundle",
      "defaultValue": "Davydov"
    },
    "vendorIdElement": {
      "type": "derived",
      "valueSource": "vendor",
      "valueTransform": "vendorIdElement",
      "replaces": "<VendorId>Davydov</VendorId>"
    },
    "vendorNameSetting": {
      "type": "derived",
      "valueSource": "vendor",
      "valueTransform": "vendorNameSetting",
      "replaces": "\"Name\": \"Davydov\""
    },
    "kebabName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebabCase",
      "replaces": "davydov-revit-addin"
    },
    "modulesName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "modulesName",
      "replaces": "Davydov.Revit.Hosting",
      "fileRename": "Davydov.Revit.Hosting"
    },
    "modulesIdentifier": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "modulesIdentifier",
      "replaces": "Davydov_Revit_Hosting"
    },
    "pipelineRun": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "run: dotnet run -c Release"
      },
      "replaces": "run: dotnet run -c Release -- test"
    },
    "pipelineStep": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "name: Compile solution"
      },
      "replaces": "name: Compile and test"
    }
  },
  "forms": {
    "kebabCase": {
      "identifier": "chain",
      "steps": [
        "lowerCase",
        "dotsToDashes"
      ]
    },
    "lowerCase": {
      "identifier": "lowerCaseInvariant"
    },
    "dotsToDashes": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": "-"
    },
    "vendorIdElement": {
      "identifier": "replace",
      "pattern": "^(.*)$",
      "replacement": "<VendorId>$1</VendorId>"
    },
    "vendorNameSetting": {
      "identifier": "replace",
      "pattern": "^(.*)$",
      "replacement": "\"Name\": \"$1\""
    },
    "modulesName": {
      "identifier": "replace",
      "pattern": "^(.*)$",
      "replacement": "$1.Hosting"
    },
    "dotsToUnderscores": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": "_"
    },
    "appendHostingIdentifier": {
      "identifier": "replace",
      "pattern": "^(.*)$",
      "replacement": "$1_Hosting"
    },
    "modulesIdentifier": {
      "identifier": "chain",
      "steps": [
        "dotsToUnderscores",
        "appendHostingIdentifier"
      ]
    }
  },
  "SpecialCustomOperations": {
    "*.cs": {
      "operations": []
    },
    "*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "style": "block",
            "startToken": "<!--",
            "endToken": "-->",
            "pseudoEndToken": "-- >"
          }
        }
      ]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".vs/**",
            ".idea/**",
            ".claude/**",
            ".template.config/**",
            "template/**",
            "tests/**",
            "docs/**",
            "wiki/**",
            "build/Modules/Test*.cs",
            "build/RepositoryModules.cs",
            "build/Modules/TemplateSolutionModule.cs",
            "LICENSE",
            "package-lock.json",
            "output/**",
            "artifacts/**",
            "**/TestResults/**",
            "**/bin/**",
            "**/obj/**",
            "**/node_modules/**",
            "**/ClientApp/dist/**",
            "**/*.user",
            "README.md",
            ".github/workflows/Template.yml",
            ".github/workflows/PublishTemplate.yml",
            ".github/workflows/Wiki.yml",
            "AGENTS.md",
            "CLAUDE.md"
          ]
        },
        {
          "condition": "(useSln)",
          "exclude": [
            "Davydov.Revit.Addin.slnx"
          ]
        }
      ]
    },
    {
      "source": "./template/content/",
      "target": "./",
      "modifiers": [
        {
          "condition": "(!useSln)",
          "exclude": [
            "Davydov.Revit.Addin.sln"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "README.md"
    },
    {
      "condition": "(useSln)",
      "path": "Davydov.Revit.Addin.sln"
    }
  ]
}
