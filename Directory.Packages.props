<Project>

    <!--
        Central Package Management — the one deviation from the Nice3point layout (plan, decision 22).
        Revit-specific packages float with the Revit version of the configuration; RevitVersion is
        set by Nice3point.Revit.Sdk from the configuration name (Debug.R25, Release.R27, ...).
    -->

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    </PropertyGroup>

    <!-- Revit API and Nice3point libraries, compiled per Revit version; build/ has no Revit version and skips them -->
    <ItemGroup Condition="'$(RevitVersion)' != ''">
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*-*"/>
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*-*"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*-*"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*-*"/>
        <PackageVersion Include="Nice3point.Revit.Logging" Version="$(RevitVersion).*-*"/>
        <PackageVersion Include="Nice3point.TUnit.Revit" Version="$(RevitVersion).*-*"/>
    </ItemGroup>

    <ItemGroup>
        <!-- One version for every Revit version; the Launcher's AssemblyLoadContext isolates it (decision 26) -->
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12"/>

        <!-- File log of ServiceDefaults: Serilog as a logging provider (decision 23) -->
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0"/>
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0"/>

        <!-- WebView2 for Davydov.Revit.Hosting.WebView; loads in the Launcher's AssemblyLoadContext like everything else -->
        <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31"/>

        <!-- Tests: TUnit on Microsoft.Testing.Platform (global.json), as in Nice3point MultiProjectSolution -->
        <PackageVersion Include="TUnit" Version="1.73.19"/>

        <!-- build/: the ModularPipelines pipeline, as in Nice3point Revit Templates -->
        <PackageVersion Include="ModularPipelines" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.Git" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.Node" Version="3.2.8"/>
        <PackageVersion Include="Sourcy.DotNet" Version="1.1.1"/>
        <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52"/>
        <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="Autodesk.PackageBuilder" Version="2.0.2"/>

        <!-- install/: the .msi builder -->
        <PackageVersion Include="WixSharp.Core" Version="2.14.1"/>
        <PackageVersion Include="WixSharp.Msi.Core" Version="2.14.1"/>

        <!-- Compile-time only -->
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageVersion Include="Polyfill" Version="11.4.3"/>
    </ItemGroup>

</Project>
