<Project Sdk="Nice3point.Revit.Sdk">

    <!--
        The add-in application (Nice3point "Revit AddIn Application"). Revit does not load this assembly
        directly: Davydov.Revit.Addin.Launcher loads it into an isolated AssemblyLoadContext (plan, section 8).
        The .addin manifest, DeployAddin and LaunchRevit live in the Launcher.
    -->

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Configurations>Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Toolkit"/>
        <PackageReference Include="Nice3point.Revit.Extensions"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all"/>
        <PackageReference Include="Polyfill" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Embedded, not WPF resources: pack URIs resolve assemblies by name and could load a second copy outside the isolated context -->
        <EmbeddedResource Include="Resources\Icons\*.png"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Davydov.Revit.Addin.ServiceDefaults\Davydov.Revit.Addin.ServiceDefaults.csproj"/>
        <ProjectReference Include="..\Davydov.Revit.Hosting\Davydov.Revit.Hosting.csproj"/>
    </ItemGroup>

</Project>
