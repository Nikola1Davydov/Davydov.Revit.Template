<Project Sdk="Nice3point.Revit.Sdk">

    <!--
        Tests inside Revit (plan, section 12), as tests/RevitAddin.Tests in Nice3point MultiProjectSolution:
        Nice3point.TUnit.Revit starts the Revit of the configuration and runs every test on its thread.
        Needs an installed and licensed Revit of that version: dotnet test -c Release.R26.
        No Polyfill package here: InternalsVisibleTo already exposes the add-in's and the module's polyfills.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
        <Configurations>Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI"/>
        <PackageReference Include="Nice3point.TUnit.Revit"/>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\source\Davydov.Revit.Addin\Davydov.Revit.Addin.csproj"/>
    </ItemGroup>

</Project>
